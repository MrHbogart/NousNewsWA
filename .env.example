# NousNews deployment environment template.
# Copy this file to .env for Docker Compose (dev and prod both read it).
# Generate strong secrets with `python passgen.py`.

PYTHON_BASE_IMAGE=python:3.12-slim
NODE_BASE_IMAGE=node:20-alpine
DOCKER_PLATFORM=

# Published host ports
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=3001

# Database (shared by the db service and mapped into DJANGO_DB_* for the backend)
POSTGRES_DB=nousnews
POSTGRES_USER=nousnews
POSTGRES_PASSWORD=change-me

# Django runtime (the backend refuses to start with DEBUG=false and a
# placeholder secret key)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# IPs of your reverse proxy (comma-separated) so the backend sees real client
# IPs (login throttling, logs). Never "*" with the backend port exposed.
FORWARDED_ALLOW_IPS=127.0.0.1

# Admin bootstrap — leave both blank to skip creating a superuser
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# Data retention (days), applied daily by the agent worker
AGENT_LOG_RETENTION_DAYS=14
RAW_NEWS_RETENTION_DAYS=60
CANDLE_RETENTION_DAYS=180

# Frontend runtime (public values baked into the client bundle)
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8081/api
NUXT_PUBLIC_SITE_DOMAIN=http://127.0.0.1:3001
# Shown on /contact (AdSense expects a way to reach the site owner)
NUXT_PUBLIC_CONTACT_EMAIL=

# LLM (optional here: the admin-set AgentConfig value wins). Without a key the
# agent still publishes briefs, using template text instead of LLM writing.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional provider API keys. A seeded source that needs one turns on at the
# next start once its key is set (or set the key per source in Django admin).
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWSAPI_API_KEY=
GNEWS_API_KEY=
MARKETAUX_API_KEY=
FRED_API_KEY=
TWELVEDATA_API_KEY=

# Crypto 1m bars via ccxt: binance (default), or kraken/coinbase/bitstamp where
# Binance is blocked. Yahoo Finance covers crypto automatically if it fails.
PRICE_CRYPTO_EXCHANGE=binance

# Article pages are fetched only from public addresses. On a host whose DNS
# answers from 198.18.0.0/15 (fake-IP proxies such as Clash) set this to true,
# or full-text fetching finds nothing.
AGENT_FETCH_ALLOW_FAKE_IP=false
